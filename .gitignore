# Landing page (Cloudflare Worker)
node_modules/
.wrangler/
.dev.vars
.env

# Dart / Flutter tooling outside app/ (app/ has its own .gitignore)
.dart_tool/
build/
.packages
pubspec_overrides.yaml

# Editors
.idea/
*.iml
.vscode/launch.json
.DS_Store

# Region packs — cooked with tools/region_cooker, never committed.
# A city is tens of megabytes and is reproducible from a pinned build date.
*.mbtiles
*.pmtiles
tools/region_cooker/dist/

# Built APKs. CI builds these from a tag and attaches them to the Release, so a
# copy sitting in the working tree is a download, not a source file — and at
# ~50 MB it is one git would carry forever.
*.apk
