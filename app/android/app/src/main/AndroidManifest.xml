<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Map tiles. Flutter only grants this in debug builds by default, so a
         release build would show an empty basemap without it. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The whole product is built on knowing where the player is. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- Walking happens with the phone in a pocket and the screen off, so the
         process has to keep receiving fixes while it is not visible.

         This is done with a foreground service typed `location`, started while
         the app is on screen, plus the persistent notification that comes with
         it. That works on while-in-use permission alone.

         ACCESS_BACKGROUND_LOCATION is deliberately NOT declared. It is only
         needed to start tracking from the background, which NoPlace never does
         — the player opens the app before they walk. Declaring it would pull in
         a Play Console declaration and a policy review for a capability we do
         not use. See docs/adr/0009-real-location.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- The foreground service's own notification. From Android 13 a service
         whose notification cannot be posted runs unannounced, and an
         unannounced foreground service is the first thing the system decides
         it can live without. Asked for at the same moment as location. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Keeps the CPU awake for the length of a walk; without it a pocketed
         phone sleeps and the trail comes back with holes in it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Doze and the OEM battery managers (Samsung's "sleeping apps", Xiaomi's
         MIUI battery saver) freeze an unexempted process minutes after the
         screen goes off — foreground service or not. That is precisely a walk
         recorded with a hole in it, so the app can ask to be exempted. It only
         ever *asks*: the prompt is one card on the map, dismissible, and the
         app works without it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:label="NoPlace"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
