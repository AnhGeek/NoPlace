{
  "$description": "Type ramp. Sizes are logical pixels (dp on Android, pt on iOS) and scale with the OS text-size setting; do not hard-code any other size.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Barlow" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "overline": { "$value": "12" },
      "caption": { "$value": "12" },
      "footnote": { "$value": "13" },
      "body": { "$value": "14" },
      "bodyLarge": { "$value": "15" },
      "title": { "$value": "17" },
      "headline": { "$value": "20" },
      "display": { "$value": "22" },
      "hero": { "$value": "26" },
      "stat": { "$value": "34" },
      "statHero": { "$value": "42" }
    },
    "lineHeight": {
      "$type": "number",
      "$description": "Multipliers applied to the font size.",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.25 },
      "normal": { "$value": 1.4 }
    },
    "tracking": {
      "$type": "dimension",
      "$description": "Letter spacing in logical pixels.",
      "tighter": { "$value": "-0.4" },
      "normal": { "$value": "0" },
      "wide": { "$value": "1.8" },
      "wider": { "$value": "2.6" },
      "widest": { "$value": "3.4" }
    }
  }
}
